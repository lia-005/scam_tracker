# gemini_api = Gemma hosted on Google AI Studio (free key: https://aistudio.google.com/apikey)
# ollama     = Gemma running locally (ollama pull gemma3:12b)
# offline    = no LLM, rule-based engine only (demo/testing)
LLM_BACKEND=gemini_api
GOOGLE_API_KEY=your_key_here
GEMMA_MODEL=gemma-3-27b-it

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:12b

DB_PATH=civicshield.db
# Windows only, e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
